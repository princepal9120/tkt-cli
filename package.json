{
  "name": "tkt-cli",
  "version": "0.4.0",
  "description": "TikTok in your terminal — browse feeds, search, interact",
  "bin": { "tkt": "./src/index.ts" },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun build --compile --minify src/index.ts --outfile tkt",
    "build:mac-arm": "bun build --compile --minify --target=bun-darwin-arm64 src/index.ts --outfile dist/tkt-darwin-arm64",
    "build:mac-x64": "bun build --compile --minify --target=bun-darwin-x64 src/index.ts --outfile dist/tkt-darwin-x64",
    "build:linux": "bun build --compile --minify --target=bun-linux-x64 src/index.ts --outfile dist/tkt-linux-x64",
    "build:all": "mkdir -p dist && bun run build:mac-arm && bun run build:mac-x64 && bun run build:linux"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  }
}
